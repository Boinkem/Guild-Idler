+ */
 .craft-picker-table {
   width: 100%;
+  table-layout: fixed;
   border-collapse: collapse;
   font-size: 0.6875rem;
   color: var(--parchment);
@@ -4521,6 +4533,7 @@ button.harvest-item:hover {
