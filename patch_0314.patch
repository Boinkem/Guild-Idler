diff --git a/src/styles/app.css b/src/styles/app.css
index 0d31158..6a7e759 100644
--- a/src/styles/app.css
+++ b/src/styles/app.css
@@ -462,21 +462,51 @@
 .raid-result-modal .section-heading { margin-top: 12px; }
 
 /*
- * Guild Hall -- facility and permanent-upgrade cards get their own
- * identity here. Raids built its identity around banner art; Guild Hall
- * has none to build around (no icons, no banners exist for this panel),
- * so the identity comes from a ledger/blueprint motif instead -- a
- * corner-cut "stamped" card shape, a lettered crest standing in for a
- * facility icon, and a tick-marked level rail replacing the plain
- * "Level N/M" text every other leveled thing in the game uses. Guild
- * Hall is the guild's administrative seat (build facilities, bank
- * permanent upgrades), so this leans official/ledger rather than
- * adventurous the way Raids' banner cards do. Scoped entirely to
- * .guild-* classes (plus the .card/.card-title/etc it still layers onto,
- * unmodified) -- Vendors, Stats, and every other shared-class panel are
- * untouched.
+ * Guild Hall -- patch 0314 dense-list redesign (Claude Design handoff,
+ * option 1c: "filtered two-column list, bonuses on top, maxed work
+ * folded away"). Replaces the old lettered-crest/corner-cut card grid
+ * (.guild-facility-card and friends, retired below) with a scannable
+ * two-column row list: name/category/level on one line, a one-line
+ * effect summary, a thin progress rule, and a compact Buy button --
+ * plus a header bonus-chip row and a collapsed "Fully built" strip that
+ * keeps the wax-seal stamp without needing a card underneath it to
+ * stamp. Nothing about game logic, costs, purchase flow, or the detail
+ * modal changed -- see GuildPanel.tsx. Scoped entirely to .guild-*
+ * classes (plus the shared .card/.section-heading/.btn-primary/etc it
+ * still layers onto, unmodified) -- Vendors, Stats, and every other
+ * shared-class panel are untouched.
  */
 
+/* Title + bonus-chip row across the top of the panel. */
+.guild-header-row {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 16px;
+  margin-bottom: 12px;
+  flex-wrap: wrap;
+}
+.guild-bonus-row { display: flex; gap: 6px; flex-wrap: wrap; }
+.guild-bonus-chip {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding: 4px 9px;
+  background: var(--panel-2);
+  border-left: 2px solid var(--brass);
+}
+.guild-bonus-chip-label {
+  font-size: 0.53125rem;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
