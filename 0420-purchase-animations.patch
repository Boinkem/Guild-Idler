+/* ---------------------------- purchase fx (0420) ---------------------------- */
+/*
+ * Patch 0420 -- see purchaseFx.tsx. Shared by the Guild Hall rows, the
+ * vendor level-up and recruiting. Every duration and delay is a multiple
+ * of --fx-t (1ms at 1x, stretched by Settings > Animation speed), the
+ * same convention the hero level-up card's --lu-t uses. Reduce motion
+ * never reaches most of this (the beats are skipped in JS), and the
+ * data-motion='off' block at the end snaps anything that does.
+ */
+.fx-layer { position: fixed; inset: 0; pointer-events: none; z-index: 9000; overflow: hidden; }
+.fx-coin, .fx-shard { position: fixed; pointer-events: none; }
+.fx-coin {
+  width: 10px; height: 10px; border-radius: 50%;
+  background: var(--brass);
+  border: 1px solid var(--brass-dim);
+  box-shadow: 0 0 6px color-mix(in srgb, var(--brass) 70%, transparent),
+    inset -2px -2px 0 color-mix(in srgb, var(--brass-dim) 70%, var(--brass)),
+    inset 2px 2px 0 color-mix(in srgb, var(--brass) 55%, white);
+}
+.fx-shard {
+  width: 7px; height: 7px;
+  background: var(--silver);
+  border: 1px solid color-mix(in srgb, var(--silver) 55%, black);
+  box-shadow: 0 0 5px color-mix(in srgb, var(--silver) 60%, transparent);
+  clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
+}
+.fx-floater {
+  position: fixed;
+  font-size: 0.6875rem;
+  font-weight: 700;
+  color: var(--blood);
+  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
+  white-space: nowrap;
+}
+.fx-card-back {
+  position: fixed;
+  display: flex; align-items: center; justify-content: center;
+  border-radius: var(--radius);
+  border: 2px solid var(--brass-dim);
+  background: radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--panel-3) 80%, var(--brass-dim)), var(--panel));
+  color: var(--brass);
+  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.55);
+}
+
+/* Odometer level roll + "+1" ember (LevelRoll). */
+.fx-roll-wrap { position: relative; display: inline-block; }
+.fx-roll { display: inline-grid; overflow: hidden; line-height: 1.3; vertical-align: bottom; }
+.fx-roll > span { grid-area: 1 / 1; }
+.fx-roll-old { visibility: hidden; }
+.fx-roll-wrap.rolling .fx-roll-old {
+  visibility: visible;
+  animation: fx-roll-out calc(var(--fx-t) * 320) cubic-bezier(.5, 0, .8, .4) forwards;
+}
+.fx-roll-wrap.rolling .fx-roll-new {
+  animation: fx-roll-in calc(var(--fx-t) * 420) cubic-bezier(.2, 1.5, .4, 1), fx-roll-glow calc(var(--fx-t) * 900) ease-out;
+}
+@keyframes fx-roll-out { to { transform: translateY(-110%); opacity: 0; } }
+@keyframes fx-roll-in { from { transform: translateY(110%); } to { transform: none; } }
+@keyframes fx-roll-glow {
+  0%, 30% { color: color-mix(in srgb, var(--brass) 70%, white); text-shadow: 0 0 8px color-mix(in srgb, var(--brass) 80%, transparent); }
+  100% { text-shadow: none; }
+}
+.fx-ember {
+  position: absolute; right: 0; top: -4px;
+  font-family: var(--font-display);
+  font-size: 0.8125rem;
+  color: color-mix(in srgb, var(--brass) 70%, white);
+  text-shadow: 0 0 6px var(--brass);
+  pointer-events: none;
+  animation: fx-ember calc(var(--fx-t) * 900) ease-out forwards;
+}
+@keyframes fx-ember {
+  0% { opacity: 0; transform: translateY(4px) scale(.6); }
+  20% { opacity: 1; transform: translateY(-6px) scale(1.15); }
+  100% { opacity: 0; transform: translateY(-22px); }
+}
+
+/* Guild Hall row: candle-light sweep, effect flash and a spark riding the rule. */
+.guild-upgrade-row.fx-levelup { animation: fx-row-glow calc(var(--fx-t) * 800) ease-out; }
+.guild-upgrade-row.fx-levelup::after,
+.upgrade-row.fx-unveiling::after {
+  content: '';
+  position: absolute; inset: 0;
+  pointer-events: none;
+  background: linear-gradient(100deg, transparent 35%, color-mix(in srgb, var(--brass) 28%, transparent) 50%, transparent 65%);
+  background-size: 260% 100%;
+  background-position: 110% 0;
+  animation: fx-sweep calc(var(--fx-t) * 700) ease-out forwards;
+}
+@keyframes fx-sweep { to { background-position: -10% 0; } }
+@keyframes fx-row-glow {
+  0% { box-shadow: inset 0 0 0 1px var(--brass); }
+  100% { box-shadow: inset 0 0 0 1px transparent; }
+}
+.guild-upgrade-row.fx-levelup .guild-row-effect { animation: fx-text-flash calc(var(--fx-t) * 900) ease-out; }
+@keyframes fx-text-flash { 0%, 35% { color: color-mix(in srgb, var(--brass) 75%, white); } }
+.guild-row-rule > span { position: relative; }
+.guild-upgrade-row.fx-levelup .guild-row-rule > span::after {
+  content: '';
+  position: absolute; right: -3px; top: -3px;
+  width: 8px; height: 8px; border-radius: 50%;
+  background: color-mix(in srgb, var(--brass) 60%, white);
+  box-shadow: 0 0 8px 2px color-mix(in srgb, var(--brass) 80%, transparent);
+  animation: fx-spark calc(var(--fx-t) * 700) ease-out forwards;
+}
+@keyframes fx-spark { 0% { opacity: 0; } 20% { opacity: 1; } 100% { opacity: 0; transform: scale(.4); } }
+
+/* Wax-seal stamp (SealStamp). The anchor is a zero-size point the caller
+   positions; the seal, ring and specks centre on it and the ink label
+   sits to its left. */
+.fx-seal-anchor { position: absolute; width: 0; height: 0; pointer-events: none; z-index: 4; }
+.fx-seal-img {
+  position: absolute; left: -27px; top: -27px;
+  width: 54px; height: 54px;
+  filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.6));
+  animation: fx-seal-drop calc(var(--fx-t) * 520) cubic-bezier(.45, 0, .75, .4) forwards;
+}
+@keyframes fx-seal-drop {
+  0% { opacity: 0; transform: translateY(-70px) scale(2.6) rotate(-30deg); }
+  30% { opacity: 1; }
+  60% { transform: translateY(0) scale(.9) rotate(-9deg); }
+  78% { transform: scale(1.07) rotate(-9deg); }
+  100% { opacity: 1; transform: scale(1) rotate(-9deg); }
+}
+.fx-seal-ring {
+  position: absolute; left: -26px; top: -26px;
+  width: 52px; height: 52px; border-radius: 50%;
+  border: 2px solid color-mix(in srgb, var(--moss) 70%, white);
+  opacity: 0;
+  animation: fx-seal-ring calc(var(--fx-t) * 600) ease-out calc(var(--fx-t) * 310) forwards;
+}
+@keyframes fx-seal-ring { 0% { opacity: .9; transform: scale(.7); } 100% { opacity: 0; transform: scale(2.3); } }
+.fx-speck { position: absolute; left: 0; top: 0; width: 0; height: 0; }
+.fx-speck > i {
+  position: absolute; left: -2px; top: -2px;
+  width: 5px; height: 5px; border-radius: 50%;
+  background: color-mix(in srgb, var(--blood) 75%, black);
+  opacity: 0;
+  animation: fx-speck calc(var(--fx-t) * 480) cubic-bezier(.1, .7, .3, 1) calc(var(--fx-t) * 310) forwards;
+}
+.fx-speck:nth-child(odd) > i { width: 3px; height: 3px; left: -1px; top: -1px; }
+@keyframes fx-speck { 0% { opacity: 1; transform: translateX(20px); } 100% { opacity: 0; transform: translateX(42px); } }
+.fx-seal-ink {
+  position: absolute; right: 36px; top: -11px;
+  white-space: nowrap;
+  font-family: var(--font-display);
+  font-size: 0.6875rem;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
+  color: color-mix(in srgb, var(--moss) 70%, white);
+  border: 2px solid currentColor;
+  border-radius: 4px;
+  padding: 2px 7px;
+  background: color-mix(in srgb, var(--panel) 70%, transparent);
+  opacity: 0;
+  animation: fx-ink calc(var(--fx-t) * 360) cubic-bezier(.3, 1.6, .5, 1) calc(var(--fx-t) * 340) forwards;
+}
+@keyframes fx-ink {
+  0% { opacity: 0; transform: rotate(-6deg) scale(1.5); }
+  100% { opacity: .95; transform: rotate(-6deg) scale(1); }
+}
+/* Already-stamped and simply revisited: the end frame, no motion. */
+.fx-seal-anchor.fx-settled .fx-seal-ring,
+.fx-seal-anchor.fx-settled .fx-speck { display: none; }
+.fx-seal-anchor.fx-settled .fx-seal-img { animation: none; transform: rotate(-9deg); }
+.fx-seal-anchor.fx-settled .fx-seal-ink { animation: none; opacity: .9; transform: rotate(-6deg); }
+.fx-stamped { animation: fx-stamp-shake calc(var(--fx-t) * 260) linear calc(var(--fx-t) * 310); }
+@keyframes fx-stamp-shake {
+  20% { transform: translate(-2px, 1px); } 40% { transform: translate(2px, -1px); }
+  60% { transform: translate(-1px, 1px); } 80% { transform: translate(1px, 0); }
+}
+.guild-row-stamp { right: 128px; top: 50%; }
+.guild-upgrade-row.fx-stamped .guild-row-name,
+.guild-upgrade-row.fx-stamped .guild-row-effect { opacity: .72; transition: opacity calc(var(--fx-t) * 400) calc(var(--fx-t) * 320); }
+/* File-away into the Fully built strip. */
+.guild-upgrade-row.fx-filing {
+  overflow: hidden;
+  animation: fx-file-away calc(var(--fx-t) * 560) cubic-bezier(.5, 0, .9, .5) forwards;
+}
+@keyframes fx-file-away {
+  0% { opacity: 1; transform: none; }
