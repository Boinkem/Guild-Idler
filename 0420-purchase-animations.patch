+  16% { transform: scale(1); } 85% { opacity: 1; } 100% { opacity: 0; }
+}
+.vendor-card.fx-vendor-lit { animation: fx-card-glow calc(var(--fx-t) * 900) ease-out; }
+@keyframes fx-card-glow {
+  0% { box-shadow: 0 0 0 1px var(--brass), 0 0 22px color-mix(in srgb, var(--brass) 45%, transparent); }
+  100% { box-shadow: 0 0 0 1px transparent; }
+}
+.vendor-card-stamp { right: 150px; top: 50%; }
+/* Ink to the seal's right here -- to its left it would sit on the
+   Crafting/Enhance/Scrap buttons. */
+.vendor-card-stamp .fx-seal-ink { right: auto; left: 36px; }
+/* .card clips its children; the vendor card has nothing that relies on
