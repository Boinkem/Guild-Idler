+.fx-mote-0 { left: 14%; } .fx-mote-1 { left: 34%; animation-delay: calc(var(--fx-t) * 380); }
+.fx-mote-2 { left: 52%; } .fx-mote-3 { left: 71%; animation-delay: calc(var(--fx-t) * 450); }
+.fx-mote-4 { left: 88%; animation-delay: calc(var(--fx-t) * 340); }
+@keyframes fx-mote { 0% { opacity: 0; transform: none; } 20% { opacity: 1; } 100% { opacity: 0; transform: translateY(-70px); } }
+.fx-signed-on {
+  /* Centred in the open space between the hero's name and status. */
