+  100% { opacity: 0; transform: rotate(25deg) scale(1.1); }
+}
+.fx-mote {
+  position: absolute; bottom: 18px;
+  width: 4px; height: 4px; border-radius: 50%;
+  background: color-mix(in srgb, var(--brass) 60%, white);
+  opacity: 0;
