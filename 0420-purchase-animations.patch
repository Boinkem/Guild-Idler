+}
+
+/* Vendor level-up: sprite hop + halo, speech bubble, card glow, stamp. */
+.vendor-sprite-wrap { position: relative; display: inline-block; flex: none; }
+.vendor-sprite-wrap.fx-hop > :not(.vendor-bubble) { animation: fx-hop calc(var(--fx-t) * 560) cubic-bezier(.3, 1.4, .5, 1); transform-origin: 50% 100%; }
+.vendor-sprite-wrap.fx-hop::before {
