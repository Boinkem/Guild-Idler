+.vendor-card { overflow: visible; }
+
+/* Padlock on locked upgrade rows, and the reveal when one gets taught. */
+.fx-lock { position: relative; display: inline-block; flex: none; width: 13px; height: 14px; color: var(--brass-dim); align-self: center; }
+.fx-lock-shackle {
+  position: absolute; left: 3px; top: 0;
+  width: 7px; height: 7px; box-sizing: border-box;
+  border: 2px solid currentColor; border-bottom: none;
+  border-radius: 4px 4px 0 0;
+  transform-origin: 6px 7px;
+}
+.fx-lock-body { position: absolute; left: 1px; top: 6px; width: 11px; height: 8px; border-radius: 2px; background: currentColor; }
+.upgrade-unveil {
+  position: absolute; inset: 0; z-index: 3;
+  display: flex; align-items: center; gap: 7px;
+  padding: 0 8px;
+  background: var(--panel);
+  border: 1px dashed var(--panel-3);
+  pointer-events: none;
+  animation: fx-veil-out calc(var(--fx-t) * 520) ease-in calc(var(--fx-t) * 580) forwards;
+}
+.upgrade-unveil .fx-lock {
+  animation: fx-lock-shake calc(var(--fx-t) * 260) linear calc(var(--fx-t) * 300),
+    fx-lock-fly calc(var(--fx-t) * 520) cubic-bezier(.3, 0, .6, 1) calc(var(--fx-t) * 580) forwards;
+}
+.upgrade-unveil .fx-lock-shackle { animation: fx-shackle calc(var(--fx-t) * 200) ease-out calc(var(--fx-t) * 580) forwards; }
+@keyframes fx-lock-shake { 20% { transform: rotate(-14deg); } 40% { transform: rotate(12deg); } 60% { transform: rotate(-8deg); } 80% { transform: rotate(5deg); } }
+@keyframes fx-shackle { to { transform: translateY(-3px) rotate(-35deg); } }
+@keyframes fx-lock-fly {
+  0% { transform: none; color: var(--brass); }
+  30% { transform: translateY(-6px) scale(1.2); color: color-mix(in srgb, var(--brass) 60%, white); }
+  100% { transform: translate(18px, -34px) rotate(25deg) scale(.6); opacity: 0; }
+}
+@keyframes fx-veil-out {
+  0%, 30% { border-color: var(--brass); }
+  100% { opacity: 0; background: transparent; border-color: transparent; }
+}
+.upgrade-row.fx-unveiling::after { animation-delay: calc(var(--fx-t) * 1100); animation-duration: calc(var(--fx-t) * 800); }
+.fx-new-tag {
+  font-family: var(--font-display);
+  font-size: 0.5625rem;
+  letter-spacing: 0.1em;
+  color: var(--ink);
