+}
+@keyframes fx-signed {
+  0% { opacity: 0; transform: rotate(-8deg) scale(1.6); }
+  12% { opacity: 1; transform: rotate(-8deg) scale(1); }
+  80% { opacity: 1; transform: rotate(-8deg); }
+  100% { opacity: 0; transform: rotate(-8deg); }
