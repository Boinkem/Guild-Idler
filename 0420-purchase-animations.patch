+  100% { opacity: 0; transform: translateY(30px) scale(.96); }
+}
+.guild-built-strip.fx-built-pulse { animation: fx-strip-glow calc(var(--fx-t) * 500) ease-out; }
+.guild-built-strip.fx-built-pulse .guild-built-count { display: inline-block; animation: fx-count-pop calc(var(--fx-t) * 450) cubic-bezier(.3, 1.6, .5, 1); }
+.guild-built-strip.fx-built-pulse .guild-built-seal { animation: fx-seal-bob calc(var(--fx-t) * 500) cubic-bezier(.3, 1.6, .5, 1); }
+@keyframes fx-strip-glow {
