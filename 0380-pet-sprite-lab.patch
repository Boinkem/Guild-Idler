+      </div>
+      <div class="field">
+        <label>Rarity (recolour tier)</label>
+        <select id="petLabRaritySelect">
+          ${['common', 'uncommon', 'rare', 'epic', 'legendary'].map((r) => `<option value="${r}" ${r === petLabState.rarity ? 'selected' : ''}>${r}</option>`).join('')}
