+/* "Gold Donated" tracker, next to the Fund the Guild button -- direct
+   request, so a player can see their lifetime Fund the Guild total
+   (state.guildDonationsTotal, already tracked for the Guild Power
+   donations component -- see GuildManager.donateToGuild's own comment)
+   at a glance rather than it being an invisible number behind the
+   modal. Same plaque shape as .guild-storage-plaque right above, moss
+   accent instead of brass so it reads as its own distinct stat rather
+   than a second gold readout. */
+.guild-donation-plaque {
+  display: inline-flex;
+  align-items: baseline;
+  gap: 8px;
+  margin: 0;
+  padding: 5px 10px;
+  border: 1px solid color-mix(in srgb, var(--moss) 45%, var(--edge));
+  clip-path: polygon(8px 0, 100% 0, 100% 100%, 0 100%, 0 8px);
+  background: color-mix(in srgb, var(--panel-2) 80%, transparent);
+}
+.guild-donation-plaque .guild-donation-label {
+  font-size: 0.5625rem;
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+  color: var(--muted);
+}
+.guild-donation-plaque .guild-donation-amount {
+  font-family: var(--font-display);
+  font-size: 0.8125rem;
+  font-weight: 700;
+  color: var(--moss);
+  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
+}
