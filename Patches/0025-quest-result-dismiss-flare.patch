From ea20e71320eeec57b7a4afce3ed74fe239d1d91c Mon Sep 17 00:00:00 2001
From: Dev <dev@example.com>
Date: Mon, 27 Jul 2026 12:38:29 +0000
Subject: [PATCH] Quest result card: pop-in/pop-out, coin/XP burst on dismiss,
 sound cue

- Added a 'collect' sound cue -- a short bright sparkle distinct from the
  fuller fanfare that already plays when the quest resolves -- timed to
  the dismiss action specifically (sound.ts).
- The reward modal now pops in on open (all .modal dialogs share this,
  not just quest results) and pops back out on dismiss instead of
  vanishing instantly (app.css, QuestResultModal.tsx).
- Dismissing a completed quest now sends gold coins and an XP sparkle
  flying up off the card and fading, matched to the collect sound.
  Overflow briefly switches to visible during the ~300ms exit so the
  particles aren't clipped by the modal's own scroll container. Only
  shows the reward types actually earned -- a failed quest with nothing
  to show just pops out cleanly with the sound, no empty coin burst
  (app.css, QuestResultModal.tsx).
---
 src/game/sound.ts           | 10 +++++-
 src/styles/app.css          | 54 ++++++++++++++++++++++++++++++
 src/ui/QuestResultModal.tsx | 65 ++++++++++++++++++++++++++++++++++---
 3 files changed, 124 insertions(+), 5 deletions(-)

diff --git a/src/game/sound.ts b/src/game/sound.ts
index e513e23..64e1ebe 100644
--- a/src/game/sound.ts
+++ b/src/game/sound.ts
@@ -12,7 +12,7 @@ import { SettingsStore } from './settings';
 
 export type SoundCue =
   | 'quest_success' | 'quest_fail' | 'level_up' | 'legendary_drop'
-  | 'chain_complete' | 'purchase' | 'error' | 'depart' | 'achievement';
+  | 'chain_complete' | 'purchase' | 'error' | 'depart' | 'achievement' | 'collect';
 
 let ctx: AudioContext | null = null;
 
@@ -85,6 +85,14 @@ const CUES: Record<SoundCue, Tone[]> = {
     { freq: 739.99, start: 0.08, duration: 0.09, type: 'square', gain: 0.35 },
     { freq: 880.0, start: 0.16, duration: 0.28, type: 'triangle', gain: 0.45 },
   ],
+  // Plays when the reward card is dismissed, timed with the coins/XP flying
+  // up off the card -- a quick bright sparkle rather than the fuller fanfare
+  // that already played when the quest resolved.
+  collect: [
+    { freq: 880.0, start: 0, duration: 0.05, type: 'triangle', gain: 0.3 },
+    { freq: 1108.73, start: 0.04, duration: 0.06, type: 'triangle', gain: 0.32 },
+    { freq: 1318.51, start: 0.09, duration: 0.14, type: 'sine', gain: 0.38 },
+  ],
 };
 
 export function playSound(cue: SoundCue): void {
diff --git a/src/styles/app.css b/src/styles/app.css
index f6d81be..b694c81 100644
--- a/src/styles/app.css
+++ b/src/styles/app.css
@@ -422,6 +422,7 @@ button:focus-visible, [tabindex]:focus-visible {
 }
 
 .modal {
+  position: relative;
   background: var(--panel);
   border: 1px solid var(--brass-dim);
   box-shadow: 0 16px 50px rgba(0, 0, 0, 0.7);
@@ -430,6 +431,59 @@ button:focus-visible, [tabindex]:focus-visible {
   max-height: 100%;
   overflow-y: auto;
   padding: 16px;
+  animation: modal-pop-in 240ms cubic-bezier(0.2, 1.4, 0.4, 1) both;
+}
+
+@keyframes modal-pop-in {
+  0% { transform: scale(0.85); opacity: 0; }
+  60% { transform: scale(1.03); opacity: 1; }
+  100% { transform: scale(1); opacity: 1; }
+}
+
+/* Overflow is switched to visible only for the ~300ms exit, so the coin/XP
+   burst below can fly past the card edge instead of being clipped by the
+   scroll container. */
+.modal.dismissing {
+  overflow: visible;
+  animation: modal-pop-out 320ms cubic-bezier(0.4, 0, 1, 1) forwards;
+}
+@keyframes modal-pop-out {
+  0% { transform: scale(1); opacity: 1; }
+  100% { transform: scale(0.92); opacity: 0; }
+}
+
+.collect-burst {
+  position: absolute;
+  left: 50%;
+  bottom: 46px;
+  width: 0;
+  height: 0;
+  pointer-events: none;
+  z-index: 6;
+}
+.collect-particle {
+  position: absolute;
+  left: 0;
+  top: 0;
+  font-family: var(--font-display);
+  font-size: 0.9375rem;
+  font-weight: bold;
+  white-space: nowrap;
+  opacity: 0;
+  animation: collect-fly 750ms ease-out forwards;
+}
+.collect-particle.coin {
+  color: var(--brass);
+  text-shadow: 0 0 8px color-mix(in srgb, var(--brass) 70%, transparent);
+}
+.collect-particle.xp {
+  color: var(--sky);
+  text-shadow: 0 0 8px color-mix(in srgb, var(--sky) 70%, transparent);
+}
+@keyframes collect-fly {
+  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
+  15% { opacity: 1; transform: translate(-50%, -50%) scale(1.15); }
+  100% { opacity: 0; transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0.85) rotate(var(--rot)); }
 }
 
 .modal h3 {
diff --git a/src/ui/QuestResultModal.tsx b/src/ui/QuestResultModal.tsx
index 322909d..ae82d35 100644
--- a/src/ui/QuestResultModal.tsx
+++ b/src/ui/QuestResultModal.tsx
@@ -1,13 +1,35 @@
-import { useEffect } from 'react';
+import { useEffect, useState } from 'react';
+import type { CSSProperties } from 'react';
 import { useEngine } from './useEngine';
 import { useSettings } from './useSettings';
+import { playSound } from '../game/sound';
 import { formatGold, RARITY_COLOR } from '../game/util';
 
+/** How long the pop-out + coin/XP burst plays before the modal actually
+ * unmounts. Matches the CSS: modal-pop-out is 320ms, collect-fly is 750ms
+ * (staggered up to ~120ms), so this gives the longest particle time to
+ * finish fading rather than getting cut off mid-flight. */
+const DISMISS_DELAY_MS = 640;
+
+const COIN_PARTICLES = [
+  { dx: -46, dy: -92, rot: -18, delay: 0 },
+  { dx: -6, dy: -112, rot: 8, delay: 50 },
+  { dx: 40, dy: -88, rot: 20, delay: 20 },
+  { dx: 62, dy: -60, rot: 26, delay: 110 },
+  { dx: -60, dy: -55, rot: -24, delay: 90 },
+];
+const XP_PARTICLES = [
+  { dx: -22, dy: -104, rot: -10, delay: 30 },
+  { dx: 24, dy: -100, rot: 12, delay: 70 },
+  { dx: 2, dy: -118, rot: 2, delay: 130 },
+];
+
 /** Shown when a quest resolves while the player is watching. */
 export function QuestResultModal() {
   const engine = useEngine();
   const { settings } = useSettings();
   const result = engine.lastResult;
+  const [dismissing, setDismissing] = useState(false);
 
   useEffect(() => {
     if (result && !settings.questResultPopups) engine.dismissResult();
@@ -15,9 +37,16 @@ export function QuestResultModal() {
 
   if (!result || !settings.questResultPopups) return null;
 
+  const handleDismiss = () => {
+    if (dismissing) return;
+    setDismissing(true);
+    playSound('collect');
+    window.setTimeout(() => engine.dismissResult(), DISMISS_DELAY_MS);
+  };
+
   return (
-    <div className="overlay" onClick={() => engine.dismissResult()}>
-      <div className="modal" onClick={(e) => e.stopPropagation()}>
+    <div className="overlay" onClick={handleDismiss}>
+      <div className={`modal ${dismissing ? 'dismissing' : ''}`} onClick={(e) => e.stopPropagation()}>
         <h3>{result.heroName} is back</h3>
         <p className="small muted" style={{ marginTop: 0 }}>{result.questName}</p>
 
@@ -75,10 +104,38 @@ export function QuestResultModal() {
         )}
 
         <div className="row end" style={{ marginTop: 12 }}>
-          <button className="btn-primary" onClick={() => engine.dismissResult()}>
+          <button className="btn-primary" onClick={handleDismiss} disabled={dismissing}>
             {result.success ? 'Good work' : 'Understood'}
           </button>
         </div>
+
+        {/* Fires once, right as the card pops out -- gold coins and an XP
+            sparkle flying up off the card and fading, matched to the
+            'collect' sound cue. Only shows the kinds of reward actually
+            earned, so a failed quest with nothing to show doesn't get a
+            coin burst it didn't earn. */}
+        {dismissing && (
+          <div className="collect-burst" aria-hidden="true">
+            {result.gold > 0 && COIN_PARTICLES.map((p, i) => (
+              <span
+                key={`coin-${i}`}
+                className="collect-particle coin"
+                style={{ '--dx': `${p.dx}px`, '--dy': `${p.dy}px`, '--rot': `${p.rot}deg`, animationDelay: `${p.delay}ms` } as CSSProperties}
+              >
+                ◆
+              </span>
+            ))}
+            {result.xp > 0 && XP_PARTICLES.map((p, i) => (
+              <span
+                key={`xp-${i}`}
+                className="collect-particle xp"
+                style={{ '--dx': `${p.dx}px`, '--dy': `${p.dy}px`, '--rot': `${p.rot}deg`, animationDelay: `${p.delay}ms` } as CSSProperties}
+              >
+                ✦
+              </span>
+            ))}
+          </div>
+        )}
       </div>
     </div>
   );
-- 
