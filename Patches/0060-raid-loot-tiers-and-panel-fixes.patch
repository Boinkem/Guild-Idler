+      const def = EQUIPMENT_BY_ID[item.defId];
+      if (def?.setId) setCounts[def.setId] = (setCounts[def.setId] ?? 0) + 1;
+    }
+    for (const [setId, count] of Object.entries(setCounts)) {
+      const set = SET_BY_ID[setId];
