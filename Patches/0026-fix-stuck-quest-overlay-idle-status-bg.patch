From 4100f8ed323804fd9ea8449e5c239e1e6b6218c0 Mon Sep 17 00:00:00 2001
From: Dev <dev@example.com>
Date: Mon, 27 Jul 2026 12:47:33 +0000
Subject: [PATCH] Fix stuck quest-result overlay + background the idle status
 text

- Fixed a real bug from the previous patch: the quest-result card's local
  'dismissing' state (and its pending dismiss timeout) could survive a
  newer result replacing an older one mid-animation -- e.g. an Auto-Chain
  hero resolving the next quest before the previous card finished popping
  out. The card could get stuck faded to invisible while the still-opaque
  .overlay behind it kept blocking every click, with nothing visible left
  to dismiss it. Split QuestResultModal into an outer decision component
  and an inner card keyed by result.questId, so a new result always gets a
  clean instance, and its pending timeout is cancelled on unmount instead
  of firing against a result it no longer owns (QuestResultModal.tsx).
- The idle companion's status line(s) (current quest / '+N more at the
  guild') now get the same theme-aware translucent background as the name
  plate above them, instead of bare text directly over the desktop
  (app.css).
---
 src/styles/app.css          | 11 ++++++++++-
 src/ui/QuestResultModal.tsx | 36 ++++++++++++++++++++++++++++++++----
 2 files changed, 42 insertions(+), 5 deletions(-)

diff --git a/src/styles/app.css b/src/styles/app.css
index b694c81..89f0653 100644
--- a/src/styles/app.css
+++ b/src/styles/app.css
@@ -216,6 +216,13 @@ button:focus-visible, [tabindex]:focus-visible {
   margin-top: 4px;
   max-width: 220px;
   text-align: center;
+  /* Same theme-aware tint as .idle-plate -- this used to be bare text
+     directly over the desktop, which was hard to read over busy or light
+     wallpaper. */
+  background: color-mix(in srgb, var(--night) 22%, transparent);
+  border: 1px solid color-mix(in srgb, var(--edge) 35%, transparent);
+  padding: 3px 8px;
+  -webkit-app-region: no-drag;
 }
 
 .idle-actions { display: flex; gap: 4px; margin-top: 6px; -webkit-app-region: no-drag; }
@@ -673,7 +680,8 @@ input[type='range'] {
 
 /* ----------------------------- hover reveal ------------------------------- */
 
-.idle-stage:hover .idle-plate {
+.idle-stage:hover .idle-plate,
+.idle-stage:hover .idle-status {
   background: color-mix(in srgb, var(--night) 92%, transparent);
   border-color: var(--edge);
 }
@@ -996,6 +1004,7 @@ input[type='range'] {
 [data-style='modern'] .toggle,
 [data-style='modern'] .toast,
 [data-style='modern'] .idle-plate,
+[data-style='modern'] .idle-status,
 [data-style='modern'] .hero-card-expand,
 [data-style='modern'] .vendor-tabs button,
 [data-style='modern'] .tabs button {
diff --git a/src/ui/QuestResultModal.tsx b/src/ui/QuestResultModal.tsx
index ae82d35..24955a6 100644
--- a/src/ui/QuestResultModal.tsx
+++ b/src/ui/QuestResultModal.tsx
@@ -1,5 +1,7 @@
-import { useEffect, useState } from 'react';
+import { useEffect, useRef, useState } from 'react';
 import type { CSSProperties } from 'react';
+import { GameEngine } from '../game/engine';
+import { QuestResult } from '../game/types';
 import { useEngine } from './useEngine';
 import { useSettings } from './useSettings';
 import { playSound } from '../game/sound';
@@ -24,12 +26,27 @@ const XP_PARTICLES = [
   { dx: 2, dy: -118, rot: 2, delay: 130 },
 ];
 
-/** Shown when a quest resolves while the player is watching. */
+/**
+ * Shown when a quest resolves while the player is watching. Split into an
+ * outer component that just decides whether to show anything, and an inner
+ * card keyed by result.questId.
+ *
+ * The key matters: Auto-Chain can resolve a fresh quest (a new lastResult)
+ * before the previous card's ~640ms dismiss animation finishes -- e.g. a
+ * hero mid-streak finishing back to back. Without the key, React reuses the
+ * same component instance across that swap, so its `dismissing` state (and
+ * the pending dismiss timeout from the *previous* result) carried over onto
+ * the new one: the card could get stuck faded to invisible mid-pop-out
+ * while the still-fully-opaque .overlay behind it kept blocking every
+ * click, with no visible dialog left to dismiss it. The key forces a full
+ * unmount/remount per result instead, so a new result always starts clean,
+ * and the effect below cancels any in-flight timeout from the one it
+ * replaced rather than letting it fire against state it no longer owns.
+ */
 export function QuestResultModal() {
   const engine = useEngine();
   const { settings } = useSettings();
   const result = engine.lastResult;
-  const [dismissing, setDismissing] = useState(false);
 
   useEffect(() => {
     if (result && !settings.questResultPopups) engine.dismissResult();
@@ -37,11 +54,22 @@ export function QuestResultModal() {
 
   if (!result || !settings.questResultPopups) return null;
 
+  return <QuestResultCard key={result.questId} result={result} engine={engine} />;
+}
+
+function QuestResultCard({ result, engine }: { result: QuestResult; engine: GameEngine }) {
+  const [dismissing, setDismissing] = useState(false);
+  const timeoutRef = useRef<number | null>(null);
+
+  useEffect(() => () => {
+    if (timeoutRef.current !== null) window.clearTimeout(timeoutRef.current);
+  }, []);
+
   const handleDismiss = () => {
     if (dismissing) return;
     setDismissing(true);
     playSound('collect');
-    window.setTimeout(() => engine.dismissResult(), DISMISS_DELAY_MS);
+    timeoutRef.current = window.setTimeout(() => engine.dismissResult(), DISMISS_DELAY_MS);
   };
 
   return (
