+        "difficulty": "epic",
+        "goldMultiplier": 2.2,
+        "durationMinutes": 780
+      }
+    ]
+  },
+  {
+    "id": "full_moon_over_ashvale",
+    "name": "Full Moon Over Ashvale",
+    "description": "The hunting-lodge town of Ashvale wants a wolf problem solved before the next full moon, except the tracks are shaped wrong, the attacks only escalate on a schedule, and at least one of the survivors is starting to act like they're waiting for something.",
+    "reqLevel": 17,
+    "rewardGold": 3400,
+    "rewardItems": [
+      "moonsilver_fang"
+    ],
+    "rewardRenown": 2,
+    "title": "Moonhunter",
+    "epilogue": "The pack's gone quiet, its alpha put down before the moon finished rising. Ashvale's grateful, if a little rattled -- one of the people the guild was sent to protect didn't make it through the last stage of this the way anyone would have wanted. Nobody's saying that part out loud yet.",
+    "stages": [
+      {
+        "name": "Not Wolves",
+        "flavour": "The bite radius is wrong for a wolf, the kills are too organized for a pack of animals, and every attack so far has landed within a day of the moon's phase -- which is either an enormous coincidence or exactly what it looks like.",
+        "tag": "explore",
+        "difficulty": "normal",
+        "goldMultiplier": 1.5,
+        "durationMinutes": 420
+      },
+      {
+        "name": "The Turned Neighbor",
+        "flavour": "One of the survivors the guild was sent to protect stopped answering to their own name three nights ago, and by the time anyone noticed, it was already too late to do anything gentle about it.",
+        "tag": "combat",
+        "difficulty": "hard",
+        "goldMultiplier": 1.8,
+        "durationMinutes": 600
+      },
+      {
+        "name": "Under a Full Moon",
+        "flavour": "The pack's run wild under a full sky before, and it'll happen again unless the guild reaches the alpha before moonrise finishes -- after that, there won't be a version of this fight anyone walks away from clean.",
+        "tag": "combat",
+        "difficulty": "epic",
+        "goldMultiplier": 2.3,
+        "durationMinutes": 900
+      }
+    ]
+  },
+  {
+    "id": "body_snatcher_problem",
+    "name": "The Body Snatcher Problem",
+    "description": "A prominent Ironrest household has started acting subtly wrong -- right words, wrong rhythm, a laugh that lands a half-second late every single time. Nobody can point to what's actually different. Everyone agrees something is.",
+    "reqLevel": 29,
+    "rewardGold": 7800,
+    "rewardItems": [
+      "unravelers_mark"
+    ],
+    "rewardRenown": 3,
+    "title": "Unmasker",
+    "epilogue": "Whatever was wearing that household is gone now, and so is whatever it was actually made of underneath. The real question -- how long it had been doing this, and to how many other households nobody's checked yet -- goes conveniently unasked by everyone who'd rather not know the answer.",
+    "stages": [
+      {
+        "name": "Wrong Rhythm",
+        "flavour": "Every answer the family gives is technically correct and somehow still feels rehearsed, like something learned the shape of a normal household from watching it rather than living in it.",
+        "tag": "explore",
+        "difficulty": "hard",
+        "goldMultiplier": 2,
+        "durationMinutes": 660
+      },
+      {
+        "name": "The Grave-Robbers' Trail",
+        "flavour": "A disturbed plot in the family crypt leads to a much larger operation than one household's worth of graves -- someone, or something, has been quietly harvesting bodies for a lot longer than anyone's noticed.",
+        "tag": "stealth",
+        "difficulty": "epic",
+        "goldMultiplier": 2.4,
+        "durationMinutes": 900
+      },
+      {
+        "name": "What Wears Them Now",
+        "flavour": "It isn't undead, and it isn't wearing a stolen face the way a shapeshifter would -- it's copying, methodically, from the inside out, and it very much does not want to stop being interrupted.",
+        "tag": "combat",
+        "difficulty": "epic",
+        "goldMultiplier": 2.8,
+        "durationMinutes": 1080
+      }
+    ]
+  },
+  {
+    "id": "hunt_a_lich",
+    "name": "Hunt-a-Lich",
+    "description": "Raised dead have been getting bolder and considerably better organized than any ordinary wight problem -- someone, or something, is directing them with real intent, and the pattern only makes sense as the early moves of someone playing a much longer game.",
