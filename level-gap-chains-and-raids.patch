index fd738b3..b1a3774 100644
--- a/src/game/data/json/quest-chains.json
+++ b/src/game/data/json/quest-chains.json
@@ -857,5 +857,263 @@
         "durationMinutes": 120
       }
     ]
+  },
+  {
+    "id": "bandits_on_the_old_road",
+    "name": "Bandits on the Old Road",
+    "description": "Every caravan coming up the old trade road tells the same story: a toll demanded at knifepoint, sometimes by a different crew than the week before. Too many bandits, too well coordinated, for this to be a handful of desperate strangers acting alone.",
+    "reqLevel": 4,
+    "rewardGold": 450,
+    "rewardItems": [
+      "tollbreakers_gloves"
+    ],
+    "rewardRenown": 1,
+    "title": "Roadwarden",
+    "epilogue": "The self-styled king of the old road answered for every toll he ever collected, all at once. The road's clear again -- for now. Someone always notices an unguarded stretch of road eventually, but that's a problem for whoever's watching next season.",
+    "stages": [
+      {
+        "name": "The Toll Nobody Asked For",
+        "flavour": "A merchant's convoy limps into town short two wagons and several fingers' worth of coin, describing the same crew that's hit half a dozen others this month -- organized, patient, and entirely too polite about the robbing.",
+        "tag": "combat",
+        "difficulty": "easy",
+        "goldMultiplier": 1.2,
+        "durationMinutes": 60
+      },
+      {
+        "name": "Whose Colors Are These",
+        "flavour": "A torn banner left behind at the ambush site doesn't match any crew the guild's dealt with before -- and asking around town turns up three other 'independent' bandit gangs flying the same colors, like someone's been recruiting rather than competing.",
+        "tag": "explore",
+        "difficulty": "easy",
+        "goldMultiplier": 1.3,
+        "durationMinutes": 90
+      },
+      {
+        "name": "The Self-Crowned King of the Old Road",
+        "flavour": "He's built himself a proper little court out of a collapsed watchtower, complete with a title nobody gave him and a small army of bandits who apparently didn't have a better offer. Someone should probably tell him how this usually ends.",
+        "tag": "combat",
+        "difficulty": "normal",
+        "goldMultiplier": 1.6,
+        "durationMinutes": 150
+      }
+    ]
+  },
+  {
+    "id": "something_big_in_the_foothills",
+    "name": "Something Big in the Foothills",
+    "description": "Herders in the foothills keep losing whole flocks overnight, and what's left behind isn't the tidy work of wolves or the opportunistic mess of bears -- fence posts are uprooted, not chewed through, and the tracks are wrong in a way nobody wants to think too hard about.",
+    "reqLevel": 12,
+    "rewardGold": 2100,
+    "rewardItems": [
+      "ridgebreakers_pauldron"
+    ],
+    "rewardRenown": 1,
+    "title": "Ridgebreaker",
+    "epilogue": "The warband's broken up and scattered back up the ridge, minus its biggest member. The foothills will probably see another one eventually -- ogres don't so much get wiped out as get bored and move on -- but that's a problem for a different season.",
+    "stages": [
+      {
+        "name": "Torn Fences, Missing Herds",
+        "flavour": "The fence wasn't broken so much as removed, posts and all, and the drag marks leading up into the hills are wide enough that two grown men could walk them side by side without touching the edges.",
+        "tag": "explore",
+        "difficulty": "normal",
+        "goldMultiplier": 1.5,
+        "durationMinutes": 480
+      },
+      {
+        "name": "The Ridge Warband",
+        "flavour": "This isn't one hungry animal passing through -- it's a proper warband, half a dozen strong, with a crude but very functional camp built out of stolen timber and whatever livestock they haven't already gotten around to eating.",
+        "tag": "combat",
+        "difficulty": "hard",
+        "goldMultiplier": 1.8,
+        "durationMinutes": 600
+      },
+      {
+        "name": "The Ridgebreaker",
+        "flavour": "The warband's biggest member earned that name honestly -- there's a boulder near the camp with a very deliberate, very deep dent in it, apparently just to make a point to the rest of the group.",
