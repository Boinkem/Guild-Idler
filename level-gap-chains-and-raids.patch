+    "rewardGold": 15000,
+    "rewardItems": [
+      "millbrook_ledger_page"
+    ],
+    "rewardRenown": 4,
+    "title": "Watcher of Millbrook",
+    "epilogue": "Nobody in Millbrook is lying, exactly -- they answer every question, and every answer is true, and every answer arrives at the same conclusion no matter what was actually asked. The guild traced the compulsion to something underneath the town before the trail went dark. Whatever it is, it noticed them looking.",
+    "stages": [
+      {
+        "name": "Flat Answers",
+        "flavour": "Every resident gives the same measured, reasonable, faintly rehearsed answer to a completely different question, right down to the same half-second pause before speaking -- as if they're all listening to something before they respond.",
+        "tag": "explore",
+        "difficulty": "epic",
+        "goldMultiplier": 2.6,
+        "durationMinutes": 1080
+      },
+      {
+        "name": "The Trail Goes Quiet",
+        "flavour": "Whatever's directing Millbrook doesn't panic when it's noticed -- it simply goes quieter, tightening its grip rather than loosening it, right up until every lead the guild had goes suddenly, deliberately cold.",
+        "tag": "arcane",
+        "difficulty": "epic",
+        "goldMultiplier": 3,
+        "durationMinutes": 1320
+      }
+    ]
+  },
+  {
+    "id": "the_loom_beneath",
+    "name": "The Loom Beneath",
+    "description": "Whatever went quiet under Millbrook hasn't stopped -- it's simply stopped being subtle about it. Tracing the compulsion back to its root leads underground, into something that was never a person and has apparently been weaving a great many of them together for longer than anyone in Millbrook has been alive.",
+    "reqLevel": 39,
+    "rewardGold": 24000,
+    "rewardItems": [
+      "loomsplinter_shard"
+    ],
+    "rewardRenown": 6,
+    "title": "Thread-Walker",
+    "epilogue": "The guild has a name for it now -- the Loom, for lack of anything it's ever called itself -- and a location, and a fairly complete picture of what it's been doing to Millbrook and probably other towns nobody's checked yet. What the guild does not have is any plan that doesn't end with someone going down there to end it directly.",
+    "requiresChainId": "quiet_in_millbrook",
+    "stages": [
+      {
+        "name": "Underneath",
+        "flavour": "The tunnels beneath Millbrook weren't dug by anything with hands -- the walls are smooth in a way that looks grown rather than carved, and every thread of pale fiber running through the stone pulls, faintly, toward the same direction.",
+        "tag": "explore",
+        "difficulty": "legendary",
+        "goldMultiplier": 3.4,
+        "durationMinutes": 1440
+      },
+      {
+        "name": "One Voice, Too Many Mouths",
+        "flavour": "It doesn't attack. It talks, calmly, through every captured townsperson at once, in perfect unison, asking the guild in a dozen borrowed voices why they'd want to unravel something that's finally made everyone agree.",
+        "tag": "arcane",
+        "difficulty": "legendary",
+        "goldMultiplier": 3.8,
+        "durationMinutes": 1560
+      }
+    ]
   }
 ]
