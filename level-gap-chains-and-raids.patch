+    ],
+    "rewardRenown": 5,
+    "title": "Grave-Marked",
+    "epilogue": "The guild found where he's holed up -- an old ossuary nobody's bothered mapping in decades -- but not what he's actually planning underneath it, only that whatever it is, he's confident enough in it to have stopped hiding. That confidence should worry everyone more than it currently does.",
+    "stages": [
+      {
+        "name": "The Dead Don't Usually Plan",
+        "flavour": "These aren't the shambling, purposeless dead the guild has cleared out before -- they're taking positions, falling back when overwhelmed, and regrouping somewhere the guild hasn't found yet. Something is thinking for them.",
+        "tag": "explore",
+        "difficulty": "epic",
+        "goldMultiplier": 2.7,
+        "durationMinutes": 1140
+      },
+      {
+        "name": "A Name in the Dark",
+        "flavour": "A captured ritual circlet, still warm, carries the trace of the same signature over and over -- a name half-erased by time and deliberately obscured the rest of the way, belonging to someone who was supposed to have died a very long time ago.",
