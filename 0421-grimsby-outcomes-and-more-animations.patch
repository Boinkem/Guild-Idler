+@keyframes fx-dim-in { from { opacity: 0; } to { opacity: 1; } }
+.peddler-modal.fx-jackpot-tell .peddler-card-row { position: relative; z-index: 2; }
+
+/* Moments (card face-up). */
+/* Bust -- sags, drains to grey, puffs dust. */
+.fx-t-bust .peddler-flip-inner {
