+/* The shared BUST card (Card, Dice and Tab): letters drop in and land crooked. */
+.grimsby-bust-card-label > span { display: inline-block; opacity: 0; animation: fx-letter-drop calc(var(--fx-t) * 420) cubic-bezier(.5, 0, .6, 1.6) forwards; }
+.grimsby-bust-card-label > span:nth-child(1) { --tilt: -6deg; }
