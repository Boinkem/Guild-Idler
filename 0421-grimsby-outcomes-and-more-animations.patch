+@keyframes fx-rain { 0% { opacity: 1; transform: translateY(0) rotate(0); } 85% { opacity: 1; } 100% { opacity: 0; transform: translateY(820px) rotate(720deg); } }
+@keyframes fx-confetti { 0% { opacity: 1; transform: translateY(0) rotate(0); } 85% { opacity: .9; } 100% { opacity: 0; transform: translateY(820px) translateX(40px) rotate(900deg); } }
+/* Reduce motion: the BUST letters' stagger delays are in --fx-t, which
+   stretches ~1000x at speed 0 -- zero them so the word just appears. */
