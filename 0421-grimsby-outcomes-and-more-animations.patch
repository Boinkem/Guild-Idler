+
+/* ---------------------- skins, revive, pets (0421) ---------------------- */
+/* Skin / tombstone purchase: the card's two swatch colours (--dye-a/b,
+   set inline per card) wash across it, a brush stroke in those colours
+   sweeps the preview into the new livery, then a glint and an OWNED
+   ribbon. See DyeFx in HeroesPanel.tsx. */
+.skin-card { position: relative; overflow: hidden; }
+.skin-card-preview {
+  position: relative;
+  height: 60px;
+  margin: -4px 0 6px;
+  display: flex; align-items: flex-end; justify-content: center;
+  border-radius: var(--radius);
+  background: radial-gradient(ellipse at 50% 85%, var(--panel-3), transparent 70%);
+}
+.skin-card-preview-base, .skin-card-preview-dye { display: flex; align-items: flex-end; justify-content: center; }
+.skin-card-preview-dye {
