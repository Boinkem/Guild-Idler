         void writeSettings({ alwaysOnTop });
       },
     },
@@ -222,7 +232,7 @@ ipcMain.handle('window:setMode', (_e, mode: 'idle' | 'menu') => {
 
 ipcMain.handle('window:setAlwaysOnTop', (_e, value: boolean) => {
   alwaysOnTop = value;
