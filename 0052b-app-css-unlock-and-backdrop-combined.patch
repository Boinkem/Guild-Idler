diff --git a/src/styles/app.css b/src/styles/app.css
index 76dcd2d..3a98f20 100644
--- a/src/styles/app.css
+++ b/src/styles/app.css
@@ -249,6 +249,39 @@ button:focus-visible, [tabindex]:focus-visible {
   -webkit-app-region: no-drag;
 }
 
+/*
+ * -webkit-app-region: drag above has zero visual effect on its own -- a
+ * player toggling "unlocked" had no way to tell it did anything until they
+ * tried dragging and got lucky. This makes the draggable state genuinely
+ * unmistakable: a dashed brass outline around the whole companion plus a
+ * darkened backing, both removed the instant it's locked again.
+ */
+.idle-root.unlocked .idle-stage {
+  outline: 2px dashed var(--brass);
+  outline-offset: 6px;
+  background: color-mix(in srgb, var(--night) 40%, transparent);
+  border-radius: 10px;
+}
+
+/*
+ * Optional backdrop behind the companion (Settings > Knight > Companion
+ * Backdrop). Off by default. Deliberately a plain background fill on the
+ * existing box -- no padding, no outset shadow/outline -- since this is a
+ * small floating window likely sized tight to its content, and anything
+ * drawn past that boundary risks getting clipped rather than actually
+ * showing. Stacks fine with the unlocked-drag outline above; they're
+ * independent states.
+ */
+[data-companion-backdrop='subtle'] .idle-stage {
+  background: color-mix(in srgb, var(--night) 25%, transparent);
+  border-radius: 14px;
+}
+[data-companion-backdrop='strong'] .idle-stage {
+  background: color-mix(in srgb, var(--night) 65%, transparent);
+  border: 1px solid var(--edge);
+  border-radius: 14px;
+}
+
 .idle-stage {
   position: relative;
   display: flex;
