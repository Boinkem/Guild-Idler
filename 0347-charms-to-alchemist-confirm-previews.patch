+        <div className="row end wrap" style={{ gap: 8, marginTop: 12 }}>
+          <button className="btn-ghost" onClick={onBack}>Choose a different option</button>
+          <button className="btn-primary" onClick={onContinue}>Continue</button>
+        </div>
+      </div>
+    </div>
+  );
+}
