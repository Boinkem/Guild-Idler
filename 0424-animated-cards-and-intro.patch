+/* ============================ patch 0424 ============================ */
+/*
+ * Patch 0424 -- the second animation pass from the Claude Design canvas
+ * (Hatch, TierUp, ChainDiscovery, Enchant, Mailbox, Achievement,
+ * Purchases, FundGuild, GuildFounded, TourSpotlight, FirstQuest,
+ * TabUnlock boards). Same rules as 0422/0423: beats are `both`-filled
+ * animations with --fx-t delays (resultFx.tsx `at()`), and every root
+ * class contains "fx-" so Reduce motion shows the final frame.
+ */
+
+/* ---- egg ready + hatch ---- */
+.hfx-nest-stage { position: relative; height: 120px; margin: -4px 0 6px; }
+.hfx-halo {
+  position: absolute; left: 50%; bottom: 26px; width: 110px; height: 110px; margin-left: -55px; border-radius: 50%;
+  background: radial-gradient(circle, currentColor, transparent 65%); opacity: .3;
+  animation: hfx-halo calc(var(--fx-t) * 1800) ease-in-out infinite;
+}
+@keyframes hfx-halo { 0%, 100% { opacity: .2; transform: scale(.9); } 60% { opacity: .5; transform: scale(1.05); } }
+.hfx-spark {
+  position: absolute; z-index: 1; width: 6px; height: 6px; margin: -3px; background: currentColor;
+  clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
+  animation: hfx-twinkle calc(var(--fx-t) * 1600) ease-in-out infinite;
+}
+.hfx-spark.s1 { left: 30%; top: 34%; }
+.hfx-spark.s2 { left: 71%; top: 46%; animation-delay: calc(var(--fx-t) * 500); }
+.hfx-spark.s3 { left: 66%; top: 14%; animation-delay: calc(var(--fx-t) * 1000); }
+@keyframes hfx-twinkle { 0%, 100% { opacity: 0; transform: scale(.4); } 50% { opacity: 1; transform: scale(1.2); } }
+.hfx-wobble {
+  position: absolute; z-index: 2; left: 50%; bottom: 20px; width: 72px; height: 72px; margin-left: -36px;
+  display: flex; align-items: center; justify-content: center; font-size: 2.6rem;
+  transform-origin: 50% 90%; animation: hfx-wob calc(var(--fx-t) * 1800) ease-in-out infinite;
