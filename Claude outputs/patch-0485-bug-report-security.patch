index 96e7bf3..3aebd98 100644
--- a/tools/devtool/server.mjs
+++ b/tools/devtool/server.mjs
@@ -4040,7 +4040,41 @@ function json(res, status, payload) {
   res.end(JSON.stringify(payload));
