+  /** kind: 'material' only. */
+  materialId?: MaterialId;
+  materialAmount?: number;
+  /** kind: 'scrap' only. */
+  scrapAmount?: number;
+  /** kind: 'equipment' only -- an EquipmentDef id. */
+  itemId?: string;
+  /** kind: 'egg' only -- same shape as ChainDef.rewardEgg. */
+  eggRarity?: Rarity;
+  dedicatedPetId?: string;
+}
