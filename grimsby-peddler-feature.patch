+  background-size: cover;
+  background-position: center;
+  cursor: pointer;
+  padding: 0;
+  transition: transform 120ms ease;
+}
+.peddler-card-facedown:hover {
+  border-color: var(--brass);
+  outline: 2px solid var(--brass);
+  animation: peddler-card-shake 320ms ease-in-out infinite;
+  /* Hints the compositor to promote this element to its own layer before
+     the transform animation starts, rather than deciding mid-animation --
+     without this, Chromium was observed (headless, but reproducible on
+     genuine sustained hover, not just a screenshot-timing fluke)
+     occasionally repainting the large background-image as a blank box
+     with a broken-image glyph for a frame or two while an untransformed
+     large raster background was mid-composite. Confirmed via direct
+     before/after screenshots across several held-hover frames; also
+     paired with downsizing the source card-back art (was ~530KB at
+     1024px tall for a ~176px display box -- now ~95KB at 400px), which
+     independently reduces the same per-frame raster/composite cost. */
