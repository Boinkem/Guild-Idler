+
+/* --------------------------- result cards (0422) --------------------------- */
+/*
+ * Patch 0422 -- the animated Quest / Story chain / Raid result cards (see
+ * resultFx.tsx). Each card is one CSS timeline: every beat is a keyframe
+ * animation with `both` fill and an inline start delay in --fx-t units,
+ * so Settings > Animation speed stretches the whole card evenly. Every
+ * root class contains "fx-", so with Reduce motion on the block near the
+ * purchase fx zeroes the delays and the global rule collapses durations:
+ * the card shows its final frame straight away.
+ */
+@keyframes qfx-fade { from { opacity: 0; } to { opacity: 1; } }
+@keyframes qfx-rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
+@keyframes qfx-pop { 0% { transform: scale(0); } 100% { transform: none; } }
+@keyframes qfx-show { from { opacity: 0; } to { opacity: 1; } }
+@keyframes qfx-hide { from { opacity: 1; } to { opacity: 0; } }
+@keyframes qfx-stamp {
+  0% { opacity: 0; transform: rotate(-8deg) scale(2); }
+  100% { opacity: 1; transform: rotate(-8deg); }
+}
+@keyframes qfx-flip {
+  0% { opacity: 0; transform: rotateY(90deg); }
+  40% { opacity: 1; }
+  100% { opacity: 1; transform: none; }
+}
+@keyframes qfx-sealdrop {
+  0% { opacity: 0; transform: translateY(-50px) scale(2.4) rotate(-30deg); }
+  30% { opacity: 1; }
+  60% { transform: scale(.9) rotate(-9deg); }
+  100% { opacity: 1; transform: rotate(-9deg); }
+}
