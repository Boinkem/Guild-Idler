diff --git a/src/game/data/progression.ts b/src/game/data/progression.ts
index c98ef52..4e46e22 100644
--- a/src/game/data/progression.ts
+++ b/src/game/data/progression.ts
@@ -848,6 +848,28 @@ export interface HeroClassDef {
    */
   milestoneUnlockDescription?: string;
   milestoneGoldCost?: number;
+  /**
+   * Patch 0296 -- the character-portrait art shown on the redesigned
+   * Recruit tab (HeroesPanel.tsx's tiered chip cards + detail modal).
+   * Deliberately a SEPARATE asset from `icon` above: `icon` is a small
+   * item-icon-style emblem (item-icons/Heroes/, used only by the Settings
+   * status-bar avatar), while this is the full character headshot/pose
+   * art the recruit card actually shows -- same "two different asset
+   * types, two different fields" split ChainDef.banner/icon already
+   * established, not a reuse of the emblem folder.
+   *
+   * Same optional-override shape as ChainDef.banner/icon (path/focusX/
+   * focusY/scale, DevTool's shared `bannerImage` field type) -- unset for
+   * every class falls back to the `public/lore/hero-portraits/<id>.png`
+   * naming convention at dead-center focus, exactly like a chain's banner
+   * falls back to `chains/<id>.jpg`. See heroPortraitSrc in
+   * HeroesPanel.tsx for the actual fallback resolution. `.png` rather
+   * than banners' `.jpg` convention on purpose -- portrait art ships with
+   * a transparent background (see claude/hero-portrait-generation-
+   * prompt.md's own generation spec), which a lossy/opaque .jpg would
+   * destroy.
+   */
+  portrait?: { path?: string; focusX?: number; focusY?: number; scale?: number };
 }
 
 /**
diff --git a/src/styles/app.css b/src/styles/app.css
index 25a465a..4795ff2 100644
--- a/src/styles/app.css
+++ b/src/styles/app.css
@@ -1652,6 +1652,118 @@ button:focus-visible, [tabindex]:focus-visible {
 .hero-tab-chip.risky { border-color: var(--blood); color: var(--blood); }
 .hero-tab-chip.risky.on { background: color-mix(in srgb, var(--blood) 20%, var(--panel-2)); }
 
+/* --------------------------- recruit tier chips --------------------------- */
+/* Patch 0296 -- Heroes > Recruit redesign: heroes grouped into their tier
+   brackets (previously one flat `.grid.three` of every class at once),
+   each shown as a short named pill with a small portrait rather than a
+   full stat card. Clicking a chip opens the existing `.overlay`/`.modal`
+   (see HeroesPanel's recruit detail modal) with the full breakdown and
+   the Purchase button -- direct request: "cards are short - on-click
+   opens a new modal that shows all their details and the Purchase
+   button." Sits directly under Recruit's own `.section-heading`, so this
+   heading is one step down from that -- smaller, no top margin bump.
+*/
+.recruit-tier-heading {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  font-family: var(--font-display);
+  font-size: 0.6875rem;
+  font-weight: 700;
+  color: var(--brass);
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  margin: 14px 0 8px;
+  padding-bottom: 4px;
+  border-bottom: 1px solid color-mix(in srgb, var(--brass-dim) 30%, var(--panel-3));
+  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
+}
+
+.recruit-row {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  margin-bottom: 4px;
+}
+
+.recruit-chip {
+  position: relative;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  background: color-mix(in srgb, var(--panel) 92%, transparent);
+  border: 1px solid color-mix(in srgb, var(--brass-dim) 55%, var(--edge));
+  border-radius: 999px;
+  box-shadow: var(--bevel), var(--carved-line);
+  padding: 6px 16px 6px 6px;
+  cursor: pointer;
+  min-width: 190px;
+  max-width: 260px;
+  font-family: inherit;
+  color: inherit;
+  text-align: left;
+  transition: border-color 90ms linear, transform 90ms linear;
+}
+.recruit-chip:hover { border-color: var(--brass); transform: translateY(-1px); }
+.recruit-chip:active { transform: translateY(0); }
+/* A recruited class stays clickable (its modal still shows the full
+   card, just with an "Already Recruited" button), just visually dimmed
+   so the eye lands on what's still available first. */
+.recruit-chip.recruited { opacity: 0.72; }
+
+.chip-icon-frame {
+  width: 40px;
+  height: 40px;
+  flex: none;
+  border-radius: 999px;
+  border: 1px solid var(--brass-dim);
+  background-color: var(--panel-2);
+  background-size: cover;
+  background-position: center;
+  background-repeat: no-repeat;
+}
