+/*
+ * Runecloth backdrops (patch 0440) -- the plain-colour alternative to the
+ * painted scene art. SettingsStore.apply() publishes the whole layered
+ * background (Moody veil, glyph tile, texture, colour ground) as --rc-*
+ * variables and sets data-backdrop-style on :root; these rules swap it in
+ * over every tab's painted art. !important is deliberate: each panel sets
+ * its painted art as an INLINE background-image, which only an
+ * !important stylesheet rule can override -- the alternative was touching
+ * all ~20 panels' JSX for a purely cosmetic switch. background-attachment
+ * stays `fixed` from .tab-scene/.vendor-scene, so the markings sit still
+ * across tab changes instead of jumping with each page's own height.
+ *
+ * Deliberately NOT applied to .craft-scene stations, the Peddler's table
+ * modals, or the egg-select scene -- those place clickable hit-targets
+ * on specific spots in their art, so they keep their painted scenes.
+ */
+:root[data-backdrop-style='runecloth'] .tab-scene,
+:root[data-backdrop-style='runecloth'] .vendor-scene,
+.runecloth-fill {
+  background-image: var(--rc-image) !important;
+  background-size: var(--rc-size) !important;
+  background-position: var(--rc-position) !important;
+  background-repeat: repeat !important;
+  background-color: var(--rc-color) !important;
