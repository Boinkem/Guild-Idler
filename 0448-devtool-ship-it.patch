+const NOTE_GROUPS = [
+  { key: 'added', label: 'Added', re: /^added\b/i },
+  { key: 'changed', label: 'Changed', re: /^(changed|updated|improved|reworked|rebalanced|adjusted|tweaked|moved|renamed)\b/i },
+  { key: 'fixed', label: 'Fixed', re: /^fixed\b/i },
