+  return heads.map((h) => {
+    const end = allHeads.find((i) => i > h.index) ?? markdown.length;
+    const section = markdown.slice(h.index, end);
+    const start = section.indexOf('```discord-update');
+    let block = null;
+    if (start !== -1) {
