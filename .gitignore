node_modules
dist
dist-electron
release
*.log

# Licensed sprite pack: usable in the project, but not redistributable as files.
# Regenerate with:  python3 tools/recolor.py --src <pack> --out public/heroes
public/heroes

# Regenerate with:  python3 tools/import_vendors.py --src <folder> --out public/vendors
public/vendors

# Regenerate with:  python3 tools/import_pets.py --src <folder with the raw sheets> --out public/pets
public/pets

# Background music track -- likely licensed audio, not redistributable
# as a file. Drop your own track at public/audio/background-music.mp3;
# see public/audio/README.md for details. The folder/README stay
# committed, just not whatever audio file lands in it.
public/audio/*
!public/audio/README.md

tools/__pycache__
tools/devtool/public/*.bak
src/game/data/json/*.bak

# Discord webhook URL for the Patches tab's "post a dev update" feature --
# a local secret, never committed. See tools/devtool/server.mjs.
tools/devtool/discord.config.json
tools/devtool/steam.config.json
