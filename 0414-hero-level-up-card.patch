+ * same way every other animation here divides by --anim-speed; Reduce
+ * motion is handled by the global :root[data-motion='off'] rule above,
+ * which snaps every one of these to its final frame. Timeline (1x):
+ *   0 dim · 150 rays + burst · 200 card pops · 350 letters drop
+ *   420 hero rises · 650 XP fills/flashes · 900 old level out, new slams in
+ *   1250 stat gains tick in · 1750 point pill · 1950 buttons
+ * .lu-multi shifts the back half ~250ms later to fit the extra level tick.
+ */
+.lu-overlay, .lu-compact {
+  --lu-t: calc(1ms / max(var(--anim-speed, 1), 0.001));
+  --lu-gold: oklch(84% 0.14 80);
+  --lu-gold-hi: oklch(90% 0.13 85);
+  --lu-green: oklch(78% 0.15 142);
