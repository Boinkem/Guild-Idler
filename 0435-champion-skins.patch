+ACLASSES['kobold']['post']=pauldron_post(-8,19,5,3)
+ACLASSES['wizard']['behind']=[cape_layer(6,-2,width=18,cols=[(0,105,170),(0,57,109),(3,25,63)])]
+_c=centaur_post
