+
+
+/* ------------------------- sidebar nav (shell pass) ---------------------- */
+
+#tabs {
+  flex: 1 1 auto; min-height: 0; overflow-y: auto;
+  display: flex; flex-direction: column; gap: 2px;
+  padding: 4px 8px 16px;
+}
+#tabs button {
+  display: flex; align-items: center; gap: 9px;
+  width: 100%; text-align: left;
+  border-radius: var(--radius-sm);
+  padding: 7px 8px;
+  font-size: 12.5px;
+}
+#tabs button i { width: 14px; font-size: 14px; color: var(--dim); flex: none; transition: transform 120ms; }
+#tabs button.active { background: #2b2741; border-color: transparent; color: #d2cefd; }
+#tabs button.active i { color: var(--brass); }
+#tabs button.group-btn.active i { transform: rotate(90deg); }
+
+/* The nested content-type strip: a vertical list hung off the active group's
+   button by a hairline, not a second horizontal tab row. */
+#subtabs {
+  flex-direction: column; gap: 1px; flex-wrap: nowrap;
+  margin: 2px 0 4px 25px;
+  padding: 0;
+  background: transparent;
+  border-bottom: none;
+  border-left: 1px solid rgba(233, 233, 237, 0.09);
+  position: static;
+}
+#subtabs button {
+  width: 100%; text-align: left;
+  padding: 5px 10px;
+  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
+  font-size: 12px;
+}
+#subtabs button.active {
+  background: rgba(145, 132, 217, 0.12);
+  color: #d2cefd;
+  box-shadow: inset 2px 0 0 var(--brass);
+  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
+}
+
+.topbar-status {
+  flex: none; min-width: 0; text-align: left;
+  padding: 10px 14px;
+  border-top: 1px solid rgba(233, 233, 237, 0.08);
+  font-size: 11.5px;
+}
+
+/* ------------------- patch flow / build & ship switch -------------------- */
+
+.patch-nav { display: flex; gap: 6px; margin-top: 14px; }
+.patch-nav button { display: flex; align-items: baseline; gap: 8px; padding: 8px 13px; }
+.patch-nav button i { align-self: center; font-size: 15px; color: var(--dim); }
+.patch-nav .patch-nav-sub { color: var(--dim); font-size: 10.5px; font-weight: 400; }
+.patch-nav button.active { background: #2b2741; border-color: var(--brass-dim); color: #d2cefd; }
+.patch-nav button.active i { color: var(--brass); }
+
+/* Step headings read as one numbered run rather than a stack of caps rules. */
+#patchFlow .section-heading, #shipFlow .section-heading {
+  font-size: 12.5px; text-transform: none; letter-spacing: -0.01em;
+  color: var(--text-bright); font-weight: 500;
+  border-bottom-color: rgba(233, 233, 237, 0.06);
+}
+
+@media (max-width: 880px) {
+  body { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'side' 'main'; }
+  .sidebar { position: static; height: auto; }
+}
