# Copy this file to .env and fill in real values as each build-order step
# lands (see guild-idler-status.md's Auction House entry, "Build order
# once started"). Leave AH_ENABLED=false until DNS, TLS, and Postgres are
# all actually confirmed working end to end -- flipping it to true is the
# very last step, not something to do while still wiring up the host.

# Gates everything except /health. Defaults to false in code even if this
# line is missing entirely -- see src/config.ts.
AH_ENABLED=false

# Port the backend listens on locally. Whatever reverse proxy / TLS
# termination sits in front of it (Cloudflare-managed domain, per the
# design doc) is expected to forward to this.
PORT=4000

# Not used yet -- wired in at the "core listings + buyout" build step,
# once Postgres is actually installed on the host.
# DATABASE_URL=postgres://user:pass@localhost:5432/guildbound_ah
