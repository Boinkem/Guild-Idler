# Copy this file to .env and fill in real values as each build-order step
# lands (see guild-idler-status.md's Auction House entry, "Build order
# once started"). Leave AH_ENABLED=false until DNS, TLS, and Postgres are
# all actually confirmed working end to end -- flipping it to true is the
# very last step, not something to do while still wiring up the host.

# Gates everything except /health. Defaults to false in code even if this
# line is missing entirely -- see src/config.ts.
AH_ENABLED=true

# Port the backend listens on locally. Whatever reverse proxy / TLS
# termination sits in front of it (Cloudflare-managed domain, per the
# design doc) is expected to forward to this.
PORT=4000

# Required for the listings/mailbox/buyout routes to register at all
# (patch 0409) -- once Postgres is actually installed on the host, run
# `npm run migrate` first (creates the schema), then set this.
# DATABASE_URL=postgres://user:pass@localhost:5432/guildbound_ah

# Required for /auth/verify to work at all (patch 0405) -- a real Steam
# Web API key, generated via the Steamworks partner site. NOT the same
# thing as the App ID below. A production secret -- never commit a real
# value here, never log it, never send it to the client.
# STEAM_WEB_API_KEY=

# GuildBound's real registered App ID. Defaults to 5143490 in code (see
# src/config.ts's STEAM_APP_ID_DEFAULT) even if this line is missing --
# only set it here if that ever changes.
# STEAM_APP_ID=5143490

# Signs/verifies session tokens (patch 0409, src/sessions.ts) -- required
# for /auth/verify to issue a usable session, and for every listings/
# mailbox/buyout route to accept one. A real production secret, generate
# with e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# -- never commit a real value here. Changing this invalidates every
# session token already issued.
# SESSION_SECRET=
