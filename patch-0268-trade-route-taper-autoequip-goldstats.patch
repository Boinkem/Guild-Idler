+    const heavyThreshold = target * Tuning.get('harvest.sellTaperHeavyFraction');
+    if (decayed <= midThreshold) return 1;
+    if (decayed <= heavyThreshold) return Tuning.get('harvest.sellTaperMidMultiplier');
