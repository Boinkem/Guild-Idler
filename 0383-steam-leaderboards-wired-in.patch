+/**
+ * Guild Power leaderboard (patch 0382) -- the two calls the custom
+ * steamworks.js fork (see electron/steamworks-leaderboards/, and its own
+ * src/api/leaderboard.rs) adds beyond what the plain npm package
+ * exposes. `steamClient` being null (Steam not running, or the current
+ * platform's build wasn't available for some reason) means these simply
+ * fail the same no-op-and-log way every other Steam call in this file
+ * already does -- no special case needed here either.
+ */
+ipcMain.handle('steam:uploadGuildPowerScore', async (_e, score: number, forceUpdate: boolean) => {
+  if (!steamClient) return false;
+  try {
+    return await steamClient.leaderboard.uploadGuildPowerScore(score, forceUpdate);
+  } catch (err) {
+    console.log('[steam] uploadGuildPowerScore failed:', err);
+    return false;
+  }
+});
+
+ipcMain.handle('steam:downloadGuildPowerEntries', async (_e, scope: 'global' | 'friends', start: number, end: number) => {
+  if (!steamClient) return null;
+  try {
+    // Passed as a plain 0/1 rather than referencing
+    // steamClient.leaderboard.GuildPowerScope.Friends/.Global directly --
+    // that's an ambient `const enum` (generated by napi-rs into
+    // client.d.ts), and this project's isolatedModules setting
+    // specifically forbids accessing an ambient const enum's VALUE
+    // members (TS2748) even though using it as a TYPE, as the cast below
+    // does, is completely fine. The raw values (Global=0, Friends=1) are
+    // the enum's own declared discriminants, not a guess -- see
+    // client.d.ts's own generated declaration.
+    const steamScope = (scope === 'friends' ? 1 : 0) as
+      Parameters<typeof steamClient.leaderboard.downloadGuildPowerEntries>[0];
+    return await steamClient.leaderboard.downloadGuildPowerEntries(steamScope, start, end);
+  } catch (err) {
+    console.log('[steam] downloadGuildPowerEntries failed:', err);
+    return null;
+  }
+});
+
+/**
+ * Local player's own SteamID64, as a string (same convention every
+ * leaderboard entry already uses, for the same precision reason) --
+ * patch 0382, needed so the Leaderboard UI can actually tell which row
+ * is "you" by comparison, not guesswork. Uses the plain achievements/DLC
+ * steamworks.js API, not the leaderboard fork specifically -- this call
+ * already existed upstream, nothing new had to be added to the fork for
+ * it.
+ */
+ipcMain.handle('steam:getLocalSteamId', () => {
+  if (!steamClient) return null;
+  try {
+    return steamClient.localplayer.getSteamId().steamId64.toString();
+  } catch (err) {
+    console.log('[steam] getSteamId failed:', err);
+    return null;
+  }
+});
+
